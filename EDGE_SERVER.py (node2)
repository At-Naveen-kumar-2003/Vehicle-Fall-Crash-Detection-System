#  CONFIGURATION  — edit these values before deployment
# ══════════════════════════════════════════════════════════════════════════════
NETWORK_KEY   = 0x5A
NODE1_ADDR    = 0x01
NODE2_ADDR    = 0x02
NODE3_ADDR    = 0x03

LORA_FREQ     = 433.0          # MHz
LORA_SF       = 9
LORA_BW       = BW.BW125 if LORA_AVAILABLE else None
LORA_CR       = CODING_RATE.CR4_5 if LORA_AVAILABLE else None
LORA_SYNC     = 0x12

