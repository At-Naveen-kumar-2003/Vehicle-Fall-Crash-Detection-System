FLASK_PORT    = 5000
FLASK_HOST    = "0.0.0.0"

# Email (Gmail SMTP) — fill in or leave blank to disable
EMAIL_SENDER   = ""            # e.g. "yourmail@gmail.com"
EMAIL_PASSWORD = ""            # App password (not account password)
EMAIL_RECIPIENT = ""           # Fleet manager email
EMAIL_COOLDOWN = 60            # seconds per event type

# Detection thresholds (tunable via /api/thresholds)
THRESHOLDS = {
    "crash_g":   25.0,   # m/s²  total acceleration > this → CRASH
    "fall_g":     1.5,   # m/s²  total acceleration < this → FALL
    "gas_ppm":  2000.0,  # ppm   gas concentration > this → GAS_ALERT
    "mpu_zero":   0.3,   # m/s²  < this → MPU_ERROR (sensor dead)
    "mpu_max":   80.0,   # m/s²  > this → MPU_ERROR (sensor noise)
}

