#!/usr/bin/env python3
"""
VehicleNet Monitor — Node 2 (Raspberry Pi Edge Server)
=======================================================
Role : Receive encrypted LoRa from Node 1, decrypt, classify faults,
       store in SQLite, serve Flask dashboard, send email alerts,
       and forward status to Node 3 via LoRa (V2V relay).

Requirements (install with pip):
    pip install flask pyserial RPi.GPIO scikit-learn openpyxl

LoRa library:
    Clone pySX127x: https://github.com/mayeranalytics/pySX127x
    sudo python3 setup.py install

GPIO Wiring (SX1278 → Raspberry Pi 5):
    VCC  → 3.3V
    GND  → GND
    MOSI → GPIO10 (SPI0 MOSI)
    MISO → GPIO9  (SPI0 MISO)
    SCK  → GPIO11 (SPI0 SCLK)
    NSS  → GPIO8  (SPI0 CE0)
    RST  → GPIO22
    DIO0 → GPIO4  (interrupt)

Usage:
    python3 edge_server.py
Dashboard:
    http://0.0.0.0:5000   (local LAN)
    http://<zerotier_ip>:5000  (remote via ZeroTier)
"""

import os, sys, time, zlib, threading, logging, smtplib, json
from datetime import datetime
from collections import deque
from email.mime.multipart import MIMEMultipart
from email.mime.text import MIMEText

