app = Flask(__name__)

@app.route("/")
def dashboard():
    return render_template_string(DASHBOARD_HTML)

@app.route("/api/latest")
def api_latest():
    with state_lock:
        return jsonify(latest_data)

@app.route("/api/history")
def api_history():
    limit  = int(request.args.get("limit", 100))
    event  = request.args.get("event", "")
    conn   = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    c = conn.cursor()
    if event:
        c.execute("SELECT * FROM sensor_data WHERE event=? "
                  "ORDER BY id DESC LIMIT ?", (event, limit))
    else:
        c.execute("SELECT * FROM sensor_data ORDER BY id DESC LIMIT ?",
                  (limit,))
    rows = [dict(r) for r in c.fetchall()]
    conn.close()
    return jsonify(rows)

@app.route("/api/alerts")
def api_alerts():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    c = conn.cursor()
    c.execute("SELECT * FROM alerts ORDER BY id DESC LIMIT 50")
    rows = [dict(r) for r in c.fetchall()]
    conn.close()
    return jsonify(rows)

@app.route("/api/thresholds", methods=["GET", "POST"])
def api_thresholds():
    global THRESHOLDS
    if request.method == "POST":
        data = request.get_json(force=True)
        with thresh_lock:
            for k, v in data.items():
                if k in THRESHOLDS:
                    THRESHOLDS[k] = float(v)
        return jsonify({"status": "ok", "thresholds": THRESHOLDS})
    with thresh_lock:
        return jsonify(THRESHOLDS)

@app.route("/api/stats")
def api_stats():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM sensor_data")
    total = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM alerts")
    alert_count = c.fetchone()[0]
    c.execute("SELECT MAX(ts) FROM sensor_data")
    last_ts = c.fetchone()[0]
    conn.close()
    return jsonify({"total": total, "alerts": alert_count, "last_ts": last_ts})

